# ═══════════════════════════════════════════════════════════════
# VITALYA — Variables d'environnement
# Copier ce fichier en .env.local et compléter les valeurs.
# Ne jamais versionner .env.local.
# ═══════════════════════════════════════════════════════════════

# ─── Supabase (publiques : exposées au navigateur, protégées par la RLS) ───
NEXT_PUBLIC_SUPABASE_URL=https://cocheygwpsdbtxegdkzf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Supabase (serveur uniquement — contourne la RLS) ───
# Utilisée uniquement par le webhook Stripe. Dashboard > Project Settings > API Keys
SUPABASE_SERVICE_ROLE_KEY=

# ─── Resend (newsletter) ───
RESEND_API_KEY=
RESEND_FROM_EMAIL=Vitalya <newsletter@votre-domaine.com>

# ─── Stripe (préparé : s'active quand toutes les valeurs sont renseignées) ───
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_EXPERT=

# ─── Notifications push (VAPID — npx web-push generate-vapid-keys) ───
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
